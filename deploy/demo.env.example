# Salin ke /etc/redis-cache-demo.env lalu sesuaikan
PORT=8080
DATABASE_URL=postgres://shop:[password]@127.0.0.1:5432/shop?sslmode=disable
DB_MAX_CONNS=20
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=[password-kuat]
REDIS_DB=0
# true: /api/cache memakai singleflight + lock Redis saat miss
STAMPEDE_PROTECT=false
PRODUCT_TTL=10m
POPULAR_TTL=60s
NOT_FOUND_TTL=30s
