# Salin ke .env (jangan di-commit), lalu isi password.
# 172.28.0.1 = gateway bridge Docker = PostgreSQL di host.
DATABASE_URL=postgres://shop:[password]@172.28.0.1:5432/shop?sslmode=disable
DB_MAX_CONNS=20
REDIS_PASSWORD=[password-kuat]
# true: /api/cache memakai singleflight + lock Redis saat miss
STAMPEDE_PROTECT=false
PRODUCT_TTL=10m
POPULAR_TTL=60s
NOT_FOUND_TTL=30s
